<?xml version="1.0" encoding="utf-8"?>
<!-- Database follower dan sesi login tidak ikut backup cloud maupun transfer perangkat. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>